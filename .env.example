# Điền Gemini API Key của bạn vào đây (Lấy miễn phí tại: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Mô hình AI xử lý (khuyên dùng gemini-2.5-flash để phản hồi cực nhanh và hiểu cả chữ, ảnh, âm thanh)
GEMINI_MODEL=gemini-2.5-flash

# Chế độ hiển thị trình duyệt: false = hiện cửa sổ, true = chạy ngầm
HEADLESS=false

# Độ trễ giữa các thao tác (ms) để giao diện trang web kịp cập nhật
ACTION_DELAY_MS=1200

# URL trang web bài tập bạn muốn bot tự động mở (nếu để trống, bot sẽ hỏi bạn hoặc mở trang demo)
TARGET_URL=

# Cổng kết nối nếu muốn bot điều khiển Chrome thật đang mở trên máy
CDP_URL=http://localhost:9222
