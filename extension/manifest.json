{
  "manifest_version": 3,
  "name": "AI English Auto Solver",
  "version": "1.2",
  "description": "Tự động đọc bài tập tiếng Anh trên tab đang mở và giải tự động bằng Gemini AI",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "webRequest",
    "alarms",
    "power"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI English Solver"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": false,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle_toolbar": {
      "suggested_key": {
        "default": "Alt+Z",
        "mac": "Alt+Z"
      },
      "description": "Bật/Tắt ẩn hiện thanh công cụ AI Solver (Chống nhắc nhở)"
    },
    "solve_question": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Giải nhanh câu hỏi hiện tại"
    },
    "next_question": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "Chuyển nhanh sang câu tiếp theo"
    }
  }
}
